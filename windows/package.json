{
  "name": "seekdesk-windows",
  "version": "0.1.0",
  "private": true,
  "description": "SeekDesk Windows · NodeSeek 多标签阅读客户端",
  "author": "SeekDesk Windows contributors (upstream: cshaizhihao)",
  "license": "GPL-3.0-only",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:app": "node scripts/parity-backend-smoke.cjs && node scripts/parity-ui-smoke.cjs && node scripts/parity-reader-smoke.cjs && node scripts/embedded-login-smoke.cjs",
    "test:public": "node scripts/parity-public-smoke.cjs",
    "test:feedback": "node scripts/feedback-smoke.cjs",
    "test:reply-refresh": "node scripts/reply-refresh-smoke.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "pack": "npm run build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "markdown-it": "^15.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "jsdom": "^27.0.0",
    "playwright-core": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "cc.seekdesk.windows",
    "productName": "SeekDesk Windows",
    "artifactName": "SeekDesk-Windows-${version}-${arch}-Setup.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "vendor/**",
      "build/icon.ico",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "../LICENSE",
        "to": "LICENSE-SeekDesk.txt"
      },
      {
        "from": "NOTICE.md",
        "to": "NOTICE.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "license": "../LICENSE",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "runAfterFinish": true
    }
  }
}
